# Zendesk Help Center to mirror
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us

# 0 = scrape every published article; set e.g. 40 for quick local runs
MAX_ARTICLES=0

# Where Markdown files are written
OUTPUT_DIR=data/articles

# Gemini API key (https://aistudio.google.com/apikey); API_KEY is accepted too
GEMINI_API_KEY=

# File Search store display name; created on first run if missing
FILE_SEARCH_STORE=help-center-kb

# Parallel article uploads
UPLOAD_WORKERS=16

# Model used by ask.py
CHAT_MODEL=gemini-3.8-flash

# Folder for run logs (latest.log / latest.json); empty = disabled
LOG_DIR=
